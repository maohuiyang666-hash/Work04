+
+function ensureTrailingSlash (value) {
+  if (!value) {
+    return value
+  }
+  return value.endsWith('/') ? value : `${value}/`
+}
+
+function trimLeadingSlash (value) {
+  return normalizeValue(value).replace(/^\/+/, '')
