+  router.replace({
+    name: 'menuConfigError',
+    query: {
+      menuName: '未知菜单',
+      componentPath: componentPath || '未知',
+      errorMessage: error.message || '组件动态导入失败'
+    }
+  }).catch(() => {})
+})
